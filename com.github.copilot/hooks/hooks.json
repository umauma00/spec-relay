{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "bash|powershell|write_bash|write_powershell|edit|create|str_replace_editor|apply_patch",
        "bash": "node \"$PLUGIN_ROOT/scripts/hook.mjs\" || true",
        "powershell": "node \"$env:PLUGIN_ROOT/scripts/hook.mjs\"; exit 0",
        "timeoutSec": 15
      }
    ]
  }
}
